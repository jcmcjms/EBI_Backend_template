@EbiBackend_HostAddress = http://localhost:5179

### Register a new user
POST {{EbiBackend_HostAddress}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "username": "testuser",
  "password": "Password123!",
  "displayName": "Test User"
}

### Login with email
POST {{EbiBackend_HostAddress}}/auth/login
Content-Type: application/json

{
  "emailOrUsername": "test@example.com",
  "password": "Password123!"
}

### Login with username
POST {{EbiBackend_HostAddress}}/auth/login
Content-Type: application/json

{
  "emailOrUsername": "testuser",
  "password": "Password123!"
}

### Refresh token
POST {{EbiBackend_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Get profile (requires Authorization header)
GET {{EbiBackend_HostAddress}}/auth/me
Authorization: Bearer {{accessToken}}

###